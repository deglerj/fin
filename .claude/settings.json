{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/go-check.sh",
            "timeout": 120,
            "statusMessage": "Running gofmt, go vet, go test..."
          }
        ]
      }
    ]
  }
}
